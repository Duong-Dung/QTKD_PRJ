    {
      "name": "03 - User & Role Management",
      "item": [
        {
          "name": "1. Get All Users (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test(\"Returned seeded users list\", function () {",
                  "    pm.expect(res.isSuccess).to.be.true;",
                  "    pm.expect(res.data.length).to.be.at.least(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "identity", "users"]
            },
            "description": "Lấy danh sách tất cả người dùng trong hệ thống (Quyền Admin)."
          },
          "response": []
        },
        {
          "name": "2. Get All Roles (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test(\"Returned 4 system roles\", function () {",
                  "    pm.expect(res.isSuccess).to.be.true;",
                  "    var roleCodes = res.data.map(function(r) { return r.code; });",
                  "    pm.expect(roleCodes).to.include(\"ADMIN\");",
                  "    pm.expect(roleCodes).to.include(\"DIRECTOR\");",
                  "    pm.expect(roleCodes).to.include(\"MANAGER\");",
                  "    pm.expect(roleCodes).to.include(\"STAFF\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "identity", "roles"]
            },
            "description": "Lấy danh sách 4 vai trò chuẩn (ADMIN, DIRECTOR, MANAGER, STAFF)."
