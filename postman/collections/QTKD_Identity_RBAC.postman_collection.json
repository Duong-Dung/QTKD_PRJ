    {
      "name": "01 - Authentication (TASK-18)",
      "item": [
        {
          "name": "1. Login Admin (Auto Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test(\"Login success with Admin role\", function () {",
                  "    pm.expect(res.isSuccess).to.be.true;",
                  "    pm.expect(res.data.token).to.be.a('string');",
                  "    pm.expect(res.data.roles).to.include('ADMIN');",
                  "});",
                  "if (res.data && res.data.token) {",
                  "    pm.collectionVariables.set(\"admin_token\", res.data.token);",
                  "    pm.collectionVariables.set(\"admin_refresh_token\", res.data.refreshToken);",
                  "    console.log(\"[SUCCESS] Saved admin_token & admin_refresh_token!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/identity/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "identity", "login"]
            },
            "description": "Đăng nhập tài khoản Admin hệ thống (tự động lưu admin_token và admin_refresh_token)."
          },
          "response": []
        },
