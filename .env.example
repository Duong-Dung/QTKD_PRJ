# =================================================================
# QTKD ABC Logistics Solution - Environment Configuration Template
# Sao chép tệp này thành .env để tùy chỉnh nếu cần:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# =================================================================

# 1. PostgreSQL Configuration
# Lưu ý: Cổng ngoài host đặt là 5433 để tránh xung đột nếu máy bạn đã cài PostgreSQL 18
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=qtkd_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 2. RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# 3. pgAdmin Configuration
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@qtkd.com
PGADMIN_PASSWORD=admin

# 4. Backend Web API Host
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5210
API_HTTPS_PORT=7203
